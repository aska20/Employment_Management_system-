# Copy this to .env and fill in your values

# Python microservice URLs (defaults shown)
VITE_FACE_SERVICE_URL=http://localhost:5001
VITE_ML_SERVICE_URL=http://localhost:5002

# MUST match FACE_SERVICE_KEY in python_services/face_service/.env
VITE_FACE_SERVICE_KEY=ems-face-secret-2024

# MUST match ML_SERVICE_KEY in python_services/ml_service/.env
VITE_ML_SERVICE_KEY=ems-ml-secret-2024
